  <diagram id="build-flow" name="Build Flow"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="b0" value="poe apps-cli-setup:build --profile suse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="b1" value="1 · build-core&lt;br&gt;fetch+sha256 → distro build_packages →&lt;br&gt;./configure --prefix --with-* → make -j6 +&lt;br&gt;make install-world-bin → verify postgres --version&lt;br&gt;→ commit postgres:suse-0.1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="b2" value="2 · build-extension &lt;name&gt; (postgis/pgvector/rum)&lt;br&gt;FROM postgres core → ext build_packages →&lt;br&gt;recipe compile → verify control file in&lt;br&gt;&lt;prefix&gt;/share/extension → commit extension/&lt;name&gt;:suse-0.1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="b3" value="3 · assemble / runtime&lt;br&gt;fresh base sandbox → copy --from core prefix →&lt;br&gt;merge each extension (staging + cp -a) →&lt;br&gt;install runtime_packages --no-recommends →&lt;br&gt;user 26:26 + config/entrypoint + port 5432 →&lt;br&gt;verify version + control files → commit runtime:suse-0.1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="b5" value="consumer&lt;br&gt;podman run runtime:suse-0.1.0 postgres --version, or&lt;br&gt;run the daemon with a volume at the data dir (deploy/*.container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="reg" value="config/registry.toml?&lt;br&gt;push / pull all final images&lt;br&gt;(never cache layers)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="220" height="90" as="geometry"/></mxCell>
